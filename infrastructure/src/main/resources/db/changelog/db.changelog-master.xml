        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1772224197407-1" author="elcaro">
        <createTable tableName="client_emails">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_emails"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-2" author="elcaro">
        <createTable tableName="client_hardware">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_hardware"/>
            </column>
            <column name="hardware_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="client_service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="ownership" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-3" author="elcaro">
        <createTable tableName="client_phones">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_phones"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(20)"/>
            <column name="expires_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-4" author="elcaro">
        <createTable tableName="client_services">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_services"/>
            </column>
            <column name="service_id" type="BIGINT"/>
            <column name="client_id" type="BIGINT"/>
            <column name="service_type" type="VARCHAR(30)"/>
            <column name="address" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="next_payment" type="TIMESTAMPTZ"/>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-5" author="elcaro">
        <createTable tableName="clients">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_clients"/>
            </column>
            <column name="client_number" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="client_name" type="VARCHAR(50)"/>
            <column name="last_name" type="VARCHAR(50)"/>
            <column name="organization_name" type="VARCHAR(100)"/>
            <column name="language_code" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="failed_login_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="locked_until" type="TIMESTAMPTZ"/>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-6" author="elcaro">
        <createTable tableName="consent_types">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_consent_types"/>
            </column>
            <column name="code" type="VARCHAR(50)"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-7" author="elcaro">
        <createTable tableName="hardware">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_hardware"/>
            </column>
            <column name="image_path" type="TEXT"/>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-8" author="elcaro">
        <createTable tableName="notification_types">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_notification_types"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-9" author="elcaro">
        <createTable tableName="services">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_services"/>
            </column>
            <column name="info" type="TEXT"/>
            <column name="name" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_fee" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-10" author="elcaro">
        <createTable tableName="services_hardware">
            <column name="hardware_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_services_hardware"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_services_hardware"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-11" author="elcaro">
        <createTable tableName="tv_channel_offers">
            <column name="tv_channel_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tv_channel_offers"/>
            </column>
            <column name="tv_service_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tv_channel_offers"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-12" author="elcaro">
        <createTable tableName="tv_channels">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tv_channels"/>
            </column>
            <column name="name" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="pictogram" type="blob">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-13" author="elcaro">
        <createTable tableName="tv_service_offers">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tv_service_offers"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_fee" type="DECIMAL(10, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-14" author="elcaro">
        <createTable tableName="user_consents">
            <column name="is_granted" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="granted_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_consents"/>
            </column>
            <column name="consent_type_id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_consents"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-15" author="elcaro">
        <createTable tableName="user_notification_settings">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_notification_settings"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="notification_type_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="channel" type="VARCHAR(20)"/>
            <column name="is_enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1772224197407-16" author="elcaro">
        <addUniqueConstraint columnNames="email" constraintName="uc_client_emails_email" tableName="client_emails"/>
    </changeSet>
    <changeSet id="1772224197407-17" author="elcaro">
        <addUniqueConstraint columnNames="phone" constraintName="uc_client_phones_phone" tableName="client_phones"/>
    </changeSet>
    <changeSet id="1772224197407-18" author="elcaro">
        <addUniqueConstraint columnNames="client_number" constraintName="uc_clients_client_number" tableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-19" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="client_emails"
                                 constraintName="FK_CLIENT_EMAILS_ON_CLIENT" referencedColumnNames="id"
                                 referencedTableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-20" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_service_id" baseTableName="client_hardware"
                                 constraintName="FK_CLIENT_HARDWARE_ON_CLIENT_SERVICE" referencedColumnNames="id"
                                 referencedTableName="client_services"/>
    </changeSet>
    <changeSet id="1772224197407-21" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="hardware_id" baseTableName="client_hardware"
                                 constraintName="FK_CLIENT_HARDWARE_ON_HARDWARE" referencedColumnNames="id"
                                 referencedTableName="hardware"/>
    </changeSet>
    <changeSet id="1772224197407-22" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="client_phones"
                                 constraintName="FK_CLIENT_PHONES_ON_CLIENT" referencedColumnNames="id"
                                 referencedTableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-23" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="client_services"
                                 constraintName="FK_CLIENT_SERVICES_ON_CLIENT" referencedColumnNames="id"
                                 referencedTableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-24" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="service_id" baseTableName="client_services"
                                 constraintName="FK_CLIENT_SERVICES_ON_SERVICE" referencedColumnNames="id"
                                 referencedTableName="services"/>
    </changeSet>
    <changeSet id="1772224197407-25" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="user_consents"
                                 constraintName="FK_USER_CONSENTS_ON_CLIENT" referencedColumnNames="id"
                                 referencedTableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-26" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="consent_type_id" baseTableName="user_consents"
                                 constraintName="FK_USER_CONSENTS_ON_CONSENT_TYPE" referencedColumnNames="id"
                                 referencedTableName="consent_types"/>
    </changeSet>
    <changeSet id="1772224197407-27" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="client_id" baseTableName="user_notification_settings"
                                 constraintName="FK_USER_NOTIFICATION_SETTINGS_ON_CLIENT" referencedColumnNames="id"
                                 referencedTableName="clients"/>
    </changeSet>
    <changeSet id="1772224197407-28" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="notification_type_id" baseTableName="user_notification_settings"
                                 constraintName="FK_USER_NOTIFICATION_SETTINGS_ON_NOTIFICATION_TYPE"
                                 referencedColumnNames="id" referencedTableName="notification_types"/>
    </changeSet>
    <changeSet id="1772224197407-29" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="hardware_id" baseTableName="services_hardware"
                                 constraintName="fk_serhar_on_hardware" referencedColumnNames="id"
                                 referencedTableName="hardware"/>
    </changeSet>
    <changeSet id="1772224197407-30" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="service_id" baseTableName="services_hardware"
                                 constraintName="fk_serhar_on_service" referencedColumnNames="id"
                                 referencedTableName="services"/>
    </changeSet>
    <changeSet id="1772224197407-31" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="tv_channel_id" baseTableName="tv_channel_offers"
                                 constraintName="fk_tvchaoff_on_t_v_channel" referencedColumnNames="id"
                                 referencedTableName="tv_channels"/>
    </changeSet>
    <changeSet id="1772224197407-32" author="elcaro">
        <addForeignKeyConstraint baseColumnNames="tv_service_id" baseTableName="tv_channel_offers"
                                 constraintName="fk_tvchaoff_on_t_v_service_offer" referencedColumnNames="id"
                                 referencedTableName="tv_service_offers"/>
    </changeSet>
    <changeSet id="1772224197407-33" author="elcaro">
        <createTable tableName="documents">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_documents"/>
            </column>
            <column name="lang_versions" type="JSONB"/>
        </createTable>
    </changeSet>

    <changeSet id="add-client-status" author="elcaro">
        <addColumn tableName="clients">
            <column name="status" type="VARCHAR(20)" defaultValue="NEW">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <include file="db/changelog/db.changelog-translations.xml"/>
    <include file="db/changelog/db.changelog-payments.xml"/>
    <include file="db/changelog/db.changelog-offers.xml"/>

    <changeSet id="rename-tv-service-offers-to-tv-channel-packages" author="elcaro">
        <addColumn tableName="tv_service_offers">
            <column name="name" type="VARCHAR(50)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropForeignKeyConstraint baseTableName="tv_channel_offers"
                                  constraintName="fk_tvchaoff_on_t_v_service_offer"/>
        <dropForeignKeyConstraint baseTableName="tv_service_offer_translations"
                                  constraintName="fk_tv_service_offer_translations_tv_service_offer"/>
        <renameTable oldTableName="tv_service_offers" newTableName="tv_channel_packages"/>
        <renameTable oldTableName="tv_service_offer_translations" newTableName="tv_channel_package_translations"/>
        <renameColumn tableName="tv_channel_package_translations"
                      oldColumnName="tv_service_offer_id"
                      newColumnName="tv_channel_package_id"
                      columnDataType="BIGINT"/>
        <addForeignKeyConstraint baseTableName="tv_channel_offers"
                                 baseColumnNames="tv_service_id"
                                 constraintName="fk_tvchaoff_on_tv_channel_package"
                                 referencedTableName="tv_channel_packages"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="tv_channel_package_translations"
                                 baseColumnNames="tv_channel_package_id"
                                 constraintName="fk_tv_channel_package_translations_tv_channel_package"
                                 referencedTableName="tv_channel_packages"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="add-client-package-subscriptions" author="elcaro">
        <createTable tableName="client_package_subscriptions">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_package_subscriptions"/>
            </column>
            <column name="client_number" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="tv_channel_package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="client_package_subscriptions"
                             columnNames="client_number, tv_channel_package_id"
                             constraintName="uq_client_package_subscriptions"/>
        <addForeignKeyConstraint baseTableName="client_package_subscriptions"
                                 baseColumnNames="tv_channel_package_id"
                                 referencedTableName="tv_channel_packages"
                                 referencedColumnNames="id"
                                 constraintName="fk_client_package_subscriptions_package"/>
    </changeSet>

    <changeSet id="seed-marketing-consent-type" author="elcaro">
        <sql>
            INSERT INTO consent_types DEFAULT VALUES;

            INSERT INTO consent_type_translations (language_code, consent_type_id, code, description)
            VALUES ('en', currval('consent_types_id_seq'), 'MARKETING', 'Marketing communications consent');

            INSERT INTO consent_type_translations (language_code, consent_type_id, code, description)
            VALUES ('pl', currval('consent_types_id_seq'), 'MARKETING', 'Zgoda na komunikację marketingową');
        </sql>
    </changeSet>

    <include file="db/changelog/db.changelog-seed-dev-consents.xml"/>

    <changeSet id="add-client-addresses-table" author="elcaro">
        <createTable tableName="client_addresses">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_client_addresses"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_active_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="contract_active_until" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="client_addresses"
                                 baseColumnNames="client_id"
                                 referencedTableName="clients"
                                 referencedColumnNames="id"
                                 constraintName="fk_client_addresses_client"/>
    </changeSet>

    <changeSet id="alter-client-services-for-addresses" author="elcaro">
        <dropNotNullConstraint tableName="client_services" columnName="address" columnDataType="VARCHAR(100)"/>
        <addColumn tableName="client_services">
            <column name="address_id" type="BIGINT"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="client_services"
                                 baseColumnNames="address_id"
                                 referencedTableName="client_addresses"
                                 referencedColumnNames="id"
                                 constraintName="fk_client_services_address"/>
        <dropColumn tableName="client_services" columnName="address"/>
    </changeSet>

    <changeSet id="make-services-monthly-fee-nullable" author="elcaro">
        <dropNotNullConstraint tableName="services" columnName="monthly_fee" columnDataType="DECIMAL(10,2)"/>
    </changeSet>

    <changeSet id="add-is-base-package-to-tv-channel-packages" author="elcaro">
        <addColumn tableName="tv_channel_packages">
            <column name="is_base_package" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-hardware-returnable-reportable-nullable" author="elcaro">
        <addColumn tableName="hardware">
            <column name="is_returnable" type="BOOLEAN"/>
            <column name="is_reportable" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-hardware-returnable-reportable-not-null" author="elcaro">
        <addNotNullConstraint tableName="hardware" columnName="is_returnable"
                              columnDataType="BOOLEAN" defaultNullValue="false"/>
        <addNotNullConstraint tableName="hardware" columnName="is_reportable"
                              columnDataType="BOOLEAN" defaultNullValue="false"/>
    </changeSet>

    <changeSet id="add-client-hardware-serial-number" author="elcaro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="client_hardware" columnName="serial_number"/>
            </not>
        </preConditions>
        <addColumn tableName="client_hardware">
            <column name="serial_number" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

