<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="offers-1-offers" author="elcaro">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="offers"/></not>
        </preConditions>
        <createTable tableName="offers">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_offers"/>
            </column>
            <column name="title" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="subtitle" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="image_url" type="VARCHAR(1000)"/>
            <column name="category" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="tags" type="VARCHAR(500)" defaultValue=""><constraints nullable="false"/></column>
            <column name="featured" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="legal_note" type="TEXT" defaultValue=""><constraints nullable="false"/></column>
            <column name="is_featured" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <changeSet id="offers-2-variants" author="elcaro">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="offer_variants"/></not>
        </preConditions>
        <createTable tableName="offer_variants">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_offer_variants"/>
            </column>
            <column name="offer_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="regular_price" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="current_price" type="DECIMAL(10,2)"><constraints nullable="false"/></column>
            <column name="period" type="VARCHAR(20)" defaultValue="MONTH"><constraints nullable="false"/></column>
            <column name="promo_description" type="VARCHAR(1000)" defaultValue=""><constraints nullable="false"/></column>
            <column name="blocks_json" type="TEXT" defaultValue="[]"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="offer_variants" baseColumnNames="offer_id"
                                 constraintName="fk_offer_variants_on_offer"
                                 referencedTableName="offers" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="offers-4-add-is-featured-column" author="elcaro">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="offers" columnName="is_featured"/></not>
        </preConditions>
        <addColumn tableName="offers">
            <column name="is_featured" type="BOOLEAN" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <changeSet id="offers-3-orders" author="elcaro">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="offer_orders"/></not>
        </preConditions>
        <createTable tableName="offer_orders">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_offer_orders"/>
            </column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="offer_variant_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="ordered_at" type="TIMESTAMPTZ"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="offer_orders" baseColumnNames="client_id"
                                 constraintName="fk_offer_orders_on_client"
                                 referencedTableName="clients" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="offer_orders" baseColumnNames="offer_variant_id"
                                 constraintName="fk_offer_orders_on_variant"
                                 referencedTableName="offer_variants" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
